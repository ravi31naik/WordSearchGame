@using WordSearchGame.Core.Models

<div class="word-list @GetPositionClass()">
    @foreach (var word in Words)
    {
        <div class="word-item @(word.IsFound ? "found" : "")">
            @word.Text
        </div>
    }
</div>

@code {
    [Parameter] public List<Word> Words { get; set; } = new();
    [Parameter] public string Position { get; set; } = "Top";

    private string GetPositionClass()
    {
        return Position is "Left" or "Right" ? "list-vertical" : "list-horizontal";
    }
}
